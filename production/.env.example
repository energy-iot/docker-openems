# Use exact sha256 digests produced by the custom OpenEMS build workflow.
BACKEND_IMAGE=ghcr.io/YOUR_GITHUB_USER/openems-backend@sha256:REPLACE_ME
UI_IMAGE=ghcr.io/YOUR_GITHUB_USER/openems-ui-backend@sha256:REPLACE_ME

OPENEMS_DOMAIN=openems.example.com
EDGE_DOMAIN=edge.openems.example.com
ACME_EMAIL=admin@example.com
TZ=Africa/Kampala

INFLUXDB_USERNAME=openems
INFLUXDB_PASSWORD=GENERATE_A_LONG_RANDOM_PASSWORD
INFLUXDB_TOKEN=GENERATE_A_LONG_RANDOM_TOKEN
INFLUXDB_ORG=openems.io
INFLUXDB_BUCKET=openems
