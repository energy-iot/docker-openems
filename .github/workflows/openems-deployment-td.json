{
    "family": "openems-deployment-td",
    "executionRoleArn": "arn:aws:iam::383166698084:role/openems-deployment-ecs-task-execution-role",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "2048",
    "memory": "6144",
    "runtimePlatform": {
        "operatingSystemFamily": "LINUX",
        "cpuArchitecture": "X86_64"
    },
    "containerDefinitions": [
        {
            "name": "openems-deployment-container-ui",
            "image": "383166698084.dkr.ecr.us-east-1.amazonaws.com/openems-ui:latest",
            "essential": true,
            "portMappings": [
                {
                    "containerPort": 8089,
                    "hostPort": 8089,
                    "protocol": "tcp"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/openems-deployment-tds",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        },
        {
            "name": "openems-deployment-container-backend",
            "image": "383166698084.dkr.ecr.us-east-1.amazonaws.com/openems-backend:latest",
            "essential": true,
            "environment": [
                {
                    "name": "DB_HOST",
                    "value": "REPLACED_BY_TERRAFORM.rds.amazonaws.com"
                },
                {
                    "name": "DB_NAME",
                    "value": "openems"
                },
                {
                    "name": "DB_USER",
                    "value": "odoo"
                },
                {
                    "name": "ODOO_HOST",
                    "value": "localhost"
                },
                {
                    "name": "ODOO_PORT",
                    "value": "8069"
                },
                {
                    "name": "INFLUX_URL",
                    "value": "http://localhost:8086"
                }
            ],
            "secrets": [
                {
                    "name": "DB_PASSWORD",
                    "valueFrom": "arn:aws:secretsmanager:us-east-1:383166698084:secret:openems-deployment-app-credentials:db_password::"
                },
                {
                    "name": "ODOO_PASSWORD",
                    "valueFrom": "arn:aws:secretsmanager:us-east-1:383166698084:secret:openems-deployment-app-credentials:odoo_password::"
                }
            ],
            "portMappings": [
                {
                    "containerPort": 8075,
                    "hostPort": 8075,
                    "protocol": "tcp"
                },
                {
                    "containerPort": 8079,
                    "hostPort": 8079,
                    "protocol": "tcp"
                },
                {
                    "containerPort": 8081,
                    "hostPort": 8081,
                    "protocol": "tcp"
                },
                {
                    "containerPort": 8082,
                    "hostPort": 8082,
                    "protocol": "tcp"
                }
            ],
            "dependsOn": [
                {
                    "containerName": "openems-deployment-container-influxdb",
                    "condition": "HEALTHY"
                }
            ],
            "healthCheck": {
                "command": [
                    "CMD-SHELL",
                    "curl -s -o /dev/null http://localhost:8075 || exit 1"
                ],
                "interval": 30,
                "timeout": 5,
                "retries": 3,
                "startPeriod": 120
            },
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/openems-deployment-tds",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        },
        {
            "name": "openems-deployment-container-odoo",
            "image": "383166698084.dkr.ecr.us-east-1.amazonaws.com/odoo:latest",
            "essential": true,
            "environment": [
                {
                    "name": "HOST",
                    "value": "REPLACED_BY_TERRAFORM.rds.amazonaws.com"
                },
                {
                    "name": "PORT",
                    "value": "5432"
                },
                {
                    "name": "USER",
                    "value": "odoo"
                }
            ],
            "secrets": [
                {
                    "name": "PASSWORD",
                    "valueFrom": "arn:aws:secretsmanager:us-east-1:383166698084:secret:openems-deployment-app-credentials:db_password::"
                }
            ],
            "portMappings": [
                {
                    "containerPort": 8069,
                    "hostPort": 8069,
                    "protocol": "tcp"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/openems-deployment-tds",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        },
        {
            "name": "openems-deployment-container-influxdb",
            "image": "influxdb:1.8",
            "essential": true,
            "environment": [
                {
                    "name": "INFLUXDB_DB",
                    "value": "openemsdb"
                },
                {
                    "name": "INFLUXDB_HTTP_AUTH_ENABLED",
                    "value": "false"
                }
            ],
            "portMappings": [
                {
                    "containerPort": 8086,
                    "hostPort": 8086,
                    "protocol": "tcp"
                }
            ],
            "healthCheck": {
                "command": [
                    "CMD-SHELL",
                    "influx -execute 'SHOW DATABASES' || exit 1"
                ],
                "interval": 10,
                "timeout": 5,
                "retries": 5,
                "startPeriod": 30
            },
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/openems-deployment-tds",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ]
}
